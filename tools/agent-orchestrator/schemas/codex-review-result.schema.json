{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "findings", "summary"],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["APPROVE", "REQUEST_CHANGES", "BLOCKED", "NOT_VERIFIABLE"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
